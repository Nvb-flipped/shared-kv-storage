  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "error",
          "message",
          "details"
        ],
        "additionalProperties": false
      },
      "Ok": {
        "type": "object",
        "properties": {
          "ok": {
            "const": true
          }
        },
        "required": [
          "ok"
        ],
        "additionalProperties": false
      },
      "Put": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string"
          }
        },
        "required": [
          "key",
          "value"
        ],
        "additionalProperties": false
      },
      "Value": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string"
          }
        },
        "required": [
          "value"
        ],
        "additionalProperties": false
      },
      "KeyValue": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        },
        "required": [
          "key",
          "value"
        ],
        "additionalProperties": false
      },
      "Get": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "owner": {
            "type": "string",
            "pattern": "^[A-Z]$"
          }
        },
        "required": [
          "key",
          "value",
          "owner"
        ],
        "additionalProperties": false
      },
      "PutResult": {
        "type": "object",
        "properties": {
          "ok": {
            "const": true
          },
          "owner": {
            "type": "string",
            "pattern": "^[A-Z]$"
          }
        },
        "required": [
          "ok",
          "owner"
        ],
        "additionalProperties": false
      },
      "StorageStats": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z]$"
          },
          "status": {
            "const": "ok"
          },
          "key_count": {
            "type": "integer",
            "minimum": 0
          },
          "pid": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "id",
          "status",
          "key_count",
          "pid"
        ],
        "additionalProperties": false
      },
      "KeyList": {
        "type": "object",
        "properties": {
          "keys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "keys"
        ],
        "additionalProperties": false
      },
      "Flush": {
        "type": "object",
        "properties": {
          "ok": {
            "const": true
          },
          "deleted": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
